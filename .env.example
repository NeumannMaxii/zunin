# Entorno Django
DEBUG=True
SECRET_KEY=django-insecure-clave-de-desarrollo-iesetyfp-bedelia-cambiar-en-produccion
ALLOWED_HOSTS=localhost,127.0.0.1

# Configuración de Base de Datos
# NOTA: Si DB_NAME se deja vacío, el sistema utilizará SQLite (db.sqlite3) automáticamente para desarrollo local.
DB_ENGINE=django.db.backends.mysql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
